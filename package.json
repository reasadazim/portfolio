{
  "name": "reasad-azim-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8091 --strictPort",
    "build": "vite build",
    "api": "node server/server.js",
    "api:php": "php -S 127.0.0.1:8093 server/router.php",
    "serve": "node server/server.js",
    "test:assistant": "node --test tests/assistant-node.test.js",
    "test:assistant:php": "node --test tests/assistant.test.js",
    "start": "vite preview --host 127.0.0.1 --port 8091 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 8092 --strictPort",
    "format": "prettier --write src build index.html vite.config.js README.md",
    "format:check": "prettier --check src build index.html vite.config.js README.md"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "dotenv": "^18.0.6",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "nodemailer": "^10.0.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
