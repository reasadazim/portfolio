# Node.js / Express production configuration (including cPanel Passenger).
# Copy to private server/.env, or set these names in the host's environment UI.
# This filename is documentation only: the app loads server/.env automatically.
# Environment variables supplied by the host override server/.env values.

GEMINI_API_KEY=
# Choose a Gemini model available to your project.
GEMINI_MODEL=gemini-2.5-flash
# Generate a unique secret of at least 32 characters. Do not reuse a demo secret.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

NODE_ENV=production
HOST=127.0.0.1
# Passenger controls the listening socket; a standalone host may assign PORT.
PORT=8093
# Enable only behind one trusted proxy which replaces forwarding headers.
TRUST_PROXY=0
# Replace these example domains with your real HTTPS origins (no trailing slash).
ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Fill in credentials from your SMTP provider; use an authorized From address.
# Expected formats: mail.example.com and contact@example.com.
SMTP_HOST=
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# For STARTTLS instead, set SMTP_PORT=587 and SMTP_ENCRYPTION=tls.

DAILY_CHAT_LIMIT_PER_IP=80
DAILY_CHAT_LIMIT_GLOBAL=1000
DAILY_EMAIL_LIMIT_PER_IP=3
