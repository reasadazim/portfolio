# Node.js / Express configuration for local development.
# Copy to server/.env for a fresh setup, then fill in your own credentials.
# Leave credentials blank to keep the corresponding service offline.
# Never put server/.env in public/, dist/, or source control.

# Gemini: use your own API key and a model available to your project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required, even without Gemini or SMTP. Generate a unique value once:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# At least 32 characters; keep stable across restarts to preserve sessions.
SESSION_SECRET=

# Backend on 8093; the Vite frontend on 8091/8092 proxies /api to it.
PORT=8093
HOST=127.0.0.1
NODE_ENV=development
# Set to 1 only behind one trusted, local HTTPS reverse proxy.
TRUST_PROXY=0
# Comma-separated origins without trailing slashes. Add your own domain.
ALLOWED_ORIGINS=https://reasadazim.com,https://www.reasadazim.com,http://127.0.0.1:8091,http://127.0.0.1:8092

# SMTP: settings from your email provider. Examples of the expected formats:
# SMTP_HOST=mail.example.com
# SMTP_USERNAME=contact@example.com
# SMTP_FROM=contact@example.com
# The From address must be an authorized sender; visitors become Reply-To.
# STARTTLS: port 587 with tls. Implicit TLS: port 465 with ssl.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Positive integers: daily chat requests per IP / globally, and emails per IP.
DAILY_CHAT_LIMIT_PER_IP=80
DAILY_CHAT_LIMIT_GLOBAL=1000
DAILY_EMAIL_LIMIT_PER_IP=3
